# ===================================================
# SÂN BÓNG PRO - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Lưu ý: Không lưu mật khẩu thật hoặc secret vào file này!
# ===================================================

# 1. Ứng dụng & Môi trường
APP_NAME="SanBongPro"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/Quan_Ly_San_Bong
APP_SECRET=YOUR_SECRET_TOKEN_DO_NOT_SHARE

# 2. Cơ sở dữ liệu MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quan_ly_san_bong
DB_USER=root
DB_PASS=

# 3. Phiên đăng nhập & Bảo mật
SESSION_LIFETIME=7200
CSRF_SECRET=YOUR_CSRF_SECRET_TOKEN_DO_NOT_SHARE

# 4. Giới hạn tần suất (Rate Limiting)
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW=900

# 5. Cổng thanh toán SePay VietQR tự động
SEPAY_ENV=sandbox
SEPAY_API_TOKEN=YOUR_SEPAY_API_TOKEN_HERE
SEPAY_WEBHOOK_KEY=YOUR_SEPAY_WEBHOOK_API_KEY_HERE
SEPAY_BASE_URL=https://userapi-sandbox.sepay.vn
SEPAY_BANK_CODE=MB
SEPAY_ACCOUNT_NUMBER=0352313548
SEPAY_ACCOUNT_NAME="NGUYEN QUANG VINH"

