# ===============================================================
# SÂN BÓNG PRO - CẤU HÌNH BẢO MẬT & ĐIỀU HƯỚNG APACHE (.htaccess)
# Tuân thủ chuẩn OWASP, Clean URLs & Phân quyền RBAC
# ===============================================================

# 1. Tắt hiển thị danh sách thư mục (Directory Browsing) & Ưu tiên index.php
Options -Indexes
DirectoryIndex index.php index.html

# 2. Ẩn chữ ký phiên bản máy chủ (Server Signature)
ServerSignature Off

# 3. Điều hướng Clean URLs & Phân quyền đường dẫn Admin
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Cho phép truyền Authorization Header vào PHP (cần cho Webhook & API)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Chặn truy cập trực tiếp các file .json, .log trong api/ và logs/
    RewriteRule ^(api|logs)/.*\.(json|log)$ - [F,L]

    # Route /portal-admin/ và /portal-admin/index.html qua cổng kiểm tra session PHP
    RewriteRule ^portal-admin/?$ portal-admin/index.php [L,QSA]
    RewriteRule ^portal-admin/index\.html$ portal-admin/index.php [L,QSA]

    # 3.1. Loại bỏ index.html khỏi URL -> Chuyển hướng 301 về trang chủ /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)index\.html(\?[^\ ]*)?\ HTTP/ [NC]
    RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

    # 3.2. Cô lập Admin: Chuyển hướng đường dẫn cũ admin.html sang /portal-admin/
    RewriteRule ^(html/)?admin(\.html)?/?$ /portal-admin/ [R=301,L]

    # 3.3. Loại bỏ đuôi .html và thư mục html/ trên URL -> Chuyển hướng 301 sang Clean URLs
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(?:html/)?(fields|booking|checkout|success|history|login|field-detail)\.html(\?[^\ ]*)?\ HTTP/ [NC]
    RewriteRule ^(html/)?(fields|booking|checkout|success|history|login|field-detail)\.html$ /$2 [R=301,L]

    # 3.4. Rewrite nội bộ phục vụ file từ thư mục html/ cho Clean URLs
    RewriteRule ^(fields|booking|checkout|success|history|login|field-detail)/?$ html/$1.html [L,QSA]
</IfModule>

# 4. Chặn tuyệt đối truy cập các tệp tin & thư mục nhạy cảm
<FilesMatch "^(\.env|\.git|\.agents|.*\.sql|.*\.bak|.*\.log|.*\.tmp|composer\.(json|lock)|sepay_paid_orders\.json|expected_orders\.json|rate_limits\.json)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Chặn truy cập trực tiếp vào thư mục config, database, logs, scripts
RedirectMatch 403 ^/(config|database|logs|scripts)/.*$

# 5. Thiết lập các Security Headers bảo vệ trình duyệt (Mục 5.2)
<IfModule mod_headers.c>
    # Chống MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Chống tấn công Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Chính sách Referrer bảo vệ rò rỉ URL nhạy cảm
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Chống truy cập thiết bị ngoại vi không mong muốn
    Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"

    # Content Security Policy (CSP) cho phép CDN Tailwind, Lucide, Fonts, VietQR API, SePay API
    Header always set Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://unpkg.com https://fonts.googleapis.com https://fonts.gstatic.com https://api.open-meteo.com https://api.vietqr.io data: blob:; img-src 'self' data: https: blob:; connect-src 'self' https://api.open-meteo.com https://api.vietqr.io https://userapi-sandbox.sepay.vn;"

    # Chống lưu cache cũ trên Reverse Proxy CDN & Trình duyệt cho HTML, JS, CSS, JSON
    <FilesMatch "\.(html|htm|js|css|json|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# 6. UTF-8 mặc định
AddDefaultCharset UTF-8
