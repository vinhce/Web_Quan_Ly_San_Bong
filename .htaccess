# ===============================================================
# SÂN BÓNG PRO - CẤU HÌNH BẢO MẬT & ĐIỀU HƯỚNG APACHE (.htaccess)
# Tuân thủ chuẩn OWASP, Clean URLs & Phân quyền RBAC
# ===============================================================

# 1. Tắt hiển thị danh sách thư mục (Directory Browsing) & Ưu tiên index.php
Options -Indexes
DirectoryIndex index.php index.html

# 2. Ẩn chữ ký phiên bản máy chủ (Server Signature)
ServerSignature Off

# 3. Điều hướng Clean URLs & Phân quyền đường dẫn Admin
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Cho phép truyền Authorization Header vào PHP (cần cho Webhook & API)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3.0. Bắt buộc HTTPS 301 trên môi trường Production (Mục 5.1)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Chặn truy cập trực tiếp các file .json, .log trong api/ và logs/
    RewriteRule ^(api|logs)/.*\.(json|log)$ - [F,L]

    # Chặn truy cập trực tiếp vào các thư mục nội bộ & partials (áp dụng trước mọi Clean URL rewrite)
    RewriteRule ^(config|database|logs|scripts|backups|cron|portal-admin/partials|docs|tests)(/|$) - [NC,F,L]

    # Route /portal-admin/ và /portal-admin/index.html qua cổng kiểm tra session PHP
    RewriteRule ^portal-admin/?$ portal-admin/index.php [L,QSA]
    RewriteRule ^portal-admin/index\.html$ portal-admin/index.php [L,QSA]

    # 3.1. Loại bỏ index.html khỏi URL -> Chuyển hướng 301 về trang chủ /
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(.*)index\.html(\?[^\ ]*)?\ HTTP/ [NC]
    RewriteRule ^(.*)index\.html$ /$1 [R=301,L]

    # 3.2. Cô lập Admin: Chuyển hướng đường dẫn cũ admin.html sang /portal-admin/
    RewriteRule ^(html/)?admin(\.html)?/?$ /portal-admin/ [R=301,L]

    # 3.2b. Đăng ký tài khoản: Chuyển hướng /register sang /login?tab=register
    RewriteRule ^register/?$ /login?tab=register [R=301,L,QSA]

    # 3.3. Loại bỏ đuôi .html và thư mục html/ trên URL -> Chuyển hướng 301 sang Clean URLs
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /(?:html/)?(fields|booking|checkout|success|history|login|field-detail|matchmaking)\.html(\?[^\ ]*)?\ HTTP/ [NC]
    RewriteRule ^(html/)?(fields|booking|checkout|success|history|login|field-detail|matchmaking)\.html$ /$2 [R=301,L]

    # 3.4. Rewrite nội bộ phục vụ file từ thư mục html/ cho Clean URLs
    RewriteRule ^(fields|booking|checkout|success|history|login|field-detail|matchmaking)/?$ html/$1.html [L,QSA]
</IfModule>

# 4. Chặn tuyệt đối truy cập các tệp tin & thư mục nhạy cảm
<FilesMatch "^(\.env|\.git|\.agents|.*\.sql(\.gz)?|.*\.bak|.*\.log|.*\.tmp|.*\.md|composer\.(json|lock)|sepay_paid_orders\.json|expected_orders\.json|rate_limits\.json|test_pitches\.php)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Giới hạn kích thước body request tối đa 10MB chống DoS payload (Mục 3.2)
LimitRequestBody 10485760

# 5. Thiết lập các Security Headers bảo vệ trình duyệt (Mục 5.2)
<IfModule mod_headers.c>
    # Bắt buộc HTTPS HSTS (1 năm, gồm subdomains)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Chống MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Chống tấn công Clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Chính sách Referrer bảo vệ rò rỉ URL nhạy cảm
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Chống truy cập thiết bị ngoại vi không mong muốn (cho phép camera tại chính domain để quét QR Admin)
    Header always set Permissions-Policy "geolocation=(), camera=(self), microphone=()"

    # Content Security Policy (CSP) cho phép CDN Tailwind, Lucide, Fonts, VietQR API, SePay API, Turnstile
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.tailwindcss.com https://unpkg.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://challenges.cloudflare.com https://api.sepay.vn https://userapi.sepay.vn https://userapi-sandbox.sepay.vn https://api.telegram.org https://api.open-meteo.com https://api.vietqr.io; frame-src 'self' https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self';"

    # Chống lưu cache cũ trên HTML, PHP và API động
    <FilesMatch "\.(html|htm|php|json)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Cho phép cache trình duyệt cho tài nguyên tĩnh có versioning ?v= (giảm số request đồng thời chống 503)
    <FilesMatch "\.(js|css|svg|ico|png|jpg|jpeg|webp|woff2?)$">
        Header set Cache-Control "public, max-age=86400, must-revalidate"
    </FilesMatch>
</IfModule>

# 6. UTF-8 mặc định
AddDefaultCharset UTF-8
